        <script><![CDATA[function onChange(control, oldValue, newValue, isLoading) {
   if (isLoading || newValue == '') {
      return;
   }

	var today = new Date();
	var date = newValue.toString().trim().split("/");
	var dateForm = new Date(date[2], date[1] - 1, date[0], 0, 0, 0);

	if(today <= dateForm) {
		g_form.addErrorMessage("Invalid date. Future dates not allowed");
		g_form.setValue("date", "");
	} else {
		g_form.clearMessages();
	}
   
}]]></script>
